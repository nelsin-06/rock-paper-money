# Required by the Go backend.
DATABASE_URL=postgres://rock_paper_money:rock_paper_money@localhost:5432/rock_paper_money?sslmode=disable
# Hosted Supabase example: postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Optional; defaults to 8080.
PORT=8080

# Used only by PostgreSQL integration tests.
TEST_DATABASE_URL=postgres://rock_paper_money:rock_paper_money@localhost:5432/rock_paper_money_test?sslmode=disable
